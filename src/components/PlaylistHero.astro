---
import type { Playlist } from '../data/playlists';

interface Props {
  playlist: Playlist;
}

const { playlist } = Astro.props;
---

<header class="compact-header" data-compact-header aria-hidden="true">
  <div class="compact-header__inner">
    <button class="compact-header__top-button" data-scroll-top type="button" aria-label="ページ上部へ戻る">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 20V4M5 11l7-7 7 7"></path>
      </svg>
    </button>
    <span class="compact-header__title" data-compact-title>{playlist.title}</span>
  </div>
</header>

<section class="playlist-hero" data-playlist-hero aria-labelledby="playlist-title">
  <div class="playlist-hero__inner">
    <div class="cover-wrap" data-cover-wrap>
      <div class="cover-visual">
        <img
          class="cover-art"
          data-cover-art
          src={playlist.image}
          alt={`${playlist.title}のプレイリストカバー`}
          width="320"
          height="320"
          fetchpriority="high"
        />
        <h1 id="playlist-title" class="playlist-meta__title" data-playlist-title>{playlist.title}</h1>
      </div>
    </div>
  </div>
</section>
